{
  "name": "ft-university",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "up:ft": "node --experimental-strip-types experiments/up.ts ft",
    "up:baseline": "node --experimental-strip-types experiments/up.ts baseline",
    "mode": "node -e \"fetch('http://localhost:8080/health').then(r=>r.json()).then(j=>console.log(j.ft?'fault-tolerant':'baseline')).catch(()=>console.log('not running'))\"",
    "demo": "node --experimental-strip-types experiments/demo.ts",
    "exp": "node --experimental-strip-types experiments/run.ts",
    "campaign": "node --experimental-strip-types experiments/campaign.ts",
    "monitoring": "docker compose --profile monitoring up -d"
  }
}
